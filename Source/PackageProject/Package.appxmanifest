<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <!-- 
    IMPORTANT: Replace Identity Name, Publisher, and PublisherDisplayName with 
    values from Partner Center after reserving your app name.
    See STORE_PUBLISHING.md for instructions.
  -->
  <Identity
    Name="ChristianHelle.SQLCompactQueryAnalyzer"
    Version="1.3.4.0"
    Publisher="CN=PLACEHOLDER"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SQL Compact Query Analyzer</DisplayName>
    <PublisherDisplayName>Christian Resma Helle</PublisherDisplayName>
    <Logo>Images\StoreLogo.scale-200.png</Logo>
    <Description>Database management and query analyzer tool for SQL Server Compact Edition</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.14393.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="SQLCEQueryAnalyzer"
      Executable="QueryAnalyzer.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">

      <uap:VisualElements
        DisplayName="SQL Compact Query Analyzer"
        Description="Database management and query analyzer tool for SQL Server Compact Edition"
        Square150x150Logo="Images\Square150x150Logo.scale-200.png"
        Square44x44Logo="Images\Square44x44Logo.scale-200.png"
        BackgroundColor="transparent">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.scale-200.png"
          Square310x310Logo="Images\LargeTile.scale-200.png"
          Square71x71Logo="Images\SmallTile.scale-200.png">
        </uap:DefaultTile>
        <uap:SplashScreen Image="Images\SplashScreen.scale-200.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="sqlcompactdb">
            <uap:SupportedFileTypes>
              <uap:FileType>.sdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>SQL Compact Database</uap:DisplayName>
            <uap:Logo>Images\StoreLogo.scale-200.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>

    </Application>
  </Applications>

</Package>
